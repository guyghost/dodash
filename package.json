{
  "name": "dodash",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "backtest": "pnpm --filter @dodash/backtest run:coinbase",
    "build": "turbo run build",
    "check": "turbo run check",
    "dev": "turbo run dev --parallel",
    "prepare": "simple-git-hooks",
    "scan:secrets": "node --test scripts/scan-secrets.test.mjs && node scripts/scan-secrets.mjs",
    "test": "turbo run test",
    "verify:commit": "pnpm check",
    "verify:push": "pnpm audit --audit-level=high && pnpm scan:secrets && pnpm check && pnpm test && pnpm build && pnpm --filter @dodash/dashboard test:sites"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm verify:commit",
    "pre-push": "pnpm verify:push"
  },
  "devDependencies": {
    "simple-git-hooks": "^2.13.1",
    "turbo": "^2.10.10",
    "typescript": "^7.0.2"
  }
}
