{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dodash-dashboard-api",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-18",
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "services": [
    {
      "binding": "AGENT_SERVICE",
      "service": "dodash-agent"
    }
  ]
}
