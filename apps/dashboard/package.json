{
  "name": "@dodash/dashboard",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prepare-sites-build.mjs",
    "check": "tsc -p tsconfig.json --noEmit",
    "deploy": "pnpm run build && wrangler deploy",
    "preview": "vite preview",
    "test": "vitest run",
    "test:sites": "node --test tests/sites-worker.test.mjs"
  },
  "dependencies": {
    "@dodash/models": "workspace:*",
    "@vitejs/plugin-react": "5.0.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "vite": "6.4.3",
    "xstate": "^5.32.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260817.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "wrangler": "^4.123.0"
  }
}
