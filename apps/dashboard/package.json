{
  "name": "@dodash/dashboard",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prepare-sites-build.mjs",
    "check": "tsc -p tsconfig.json --noEmit",
    "deploy": "pnpm run build && wrangler deploy",
    "preview": "vite preview",
    "test": "vitest run",
    "test:sites": "node --test tests/sites-worker.test.mjs"
  },
  "dependencies": {
    "@dodash/models": "workspace:*",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "xstate": "^5.33.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261027.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "^30.1.3",
    "typescript": "^7.0.2",
    "vite": "8.2.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.154.0"
  }
}
